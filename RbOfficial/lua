--------------------------------------------------
-- 20 SECOND LOADING
--------------------------------------------------

for i = 20, 1, -1 do
	statusText.Text = "Please wait... " .. i .. "s"
	task.wait(1)
end

--------------------------------------------------
-- FADE OUT
--------------------------------------------------

local fade = TweenService:Create(
	loadingFrame,
	TweenInfo.new(0.4),
	{
		BackgroundTransparency = 1
	}
)

fade:Play()
task.wait(0.4)
loadingFrame:Destroy()

